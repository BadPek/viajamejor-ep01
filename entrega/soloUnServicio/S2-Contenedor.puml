@startuml S2-Contenedor
!include <C4/C4_Container>

title ms-reservas — C4 Nivel 2: Diagrama de Contenedores

LAYOUT_WITH_LEGEND()

Person(viajero, "Viajero", "Envía solicitud de compra")
Container(apigw, "Amazon API Gateway", "Managed Gateway", "Valida JWT y enruta")

System_Boundary(b_msRes, "Frontera de ms-reservas") {
  Container(app, "ms-reservas Application", "Spring Boot 3 · Java 21 · ECS Fargate", "Expone API REST /api/reservas, ejecuta lógica de negocio, coordina la saga y gestiona estados")
  ContainerDb(db, "BD Reservas", "Amazon Aurora Serverless v2 (PostgreSQL)", "Tablas de reservas, pasajeros, itinerarios y estados (aislada por dominio)")
}

ContainerDb(cache, "Caché de Locks", "Amazon ElastiCache Redis", "SETNX con TTL de 15 min")
Container(msPag, "ms-pagos", "Spring Boot 3", "Servicio de cobros")
Container(msInt, "ms-integraciones", "Spring Boot 3", "Servicio de proveedores")
ContainerQueue(sqs, "Cola de Emisión", "Amazon SQS + DLQ", "Mensajes persistidos")
Container(bus, "Bus de Eventos", "Amazon EventBridge", "Fan-out de eventos")

Rel(viajero, apigw, "POST /api/reservas/confirmar", "HTTPS REST + JWT")
Rel(apigw, app, "Enruta tráfico interno", "HTTPS REST")
Rel(app, db, "Persiste y lee órdenes", "JPA / JDBC TLS")
Rel(app, cache, "Bloqueo atómico de inventario", "RESP")
Rel(app, msInt, "Verifica disponibilidad", "REST (Circuit Breaker)")
Rel(app, msPag, "Solicita cobro", "REST (Circuit Breaker)")
Rel(app, sqs, "Publica reserva.pagada", "AWS SDK")
Rel(app, bus, "Publica cambios de estado", "AWS SDK")

SHOW_LEGEND()
@enduml
