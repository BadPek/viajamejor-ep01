@startuml S5-Infra-AWS
!include <C4/C4_Deployment>

title ms-reservas — Infraestructura AWS y Despliegue Dedicado (Multi-AZ)

LAYOUT_WITH_LEGEND()

Person(viajero, "Viajero", "Envía solicitud de compra")

Deployment_Node(aws, "Amazon Web Services (AWS)", "Región us-east-1") {

  Deployment_Node(edge, "Entrada Perimetral", "API Gateway") {
    Deployment_Node(apigw, "Amazon API Gateway", "Ruta /api/reservas* · JWT · Throttling")
  }

  Deployment_Node(vpc, "VPC ms-reservas (Multi-AZ)", "Subredes Privadas") {
    Deployment_Node(alb, "Application Load Balancer (ALB)", "Balanceo interno a Fargate")
    
    Deployment_Node(ecs, "Clúster ECS Fargate (ms-reservas)", "Auto Scaling 2 a 10 tareas") {
      Container(t1, "Tarea Fargate (AZ A)", "Spring Boot 3 · Java 21", "Instancia activa")
      Container(t2, "Tarea Fargate (AZ B)", "Spring Boot 3 · Java 21", "Instancia activa")
    }

    Deployment_Node(data, "Persistencia Dedicada (Aislamiento por Dominio)", "Aurora PostgreSQL") {
      ContainerDb(aurora, "Aurora Serverless v2", "Clúster exclusivo ms-reservas", "Tablas reservas y pasajeros")
    }
  }

  Deployment_Node(deps, "Dependencias del Ecosistema", "Servicios Vecinos y Caché") {
    ContainerDb(redis, "Amazon ElastiCache Redis", "Cluster In-Memory", "Locks temporales de cupos (SETNX)")
    Container(msPag, "ms-pagos", "Spring Boot 3", "Servicio de cobros")
    Container(msInt, "ms-integraciones", "Spring Boot 3", "Servicio de proveedores")
    ContainerQueue(sqs, "Amazon SQS (+ DLQ)", "Cola de emisión", "Mensajes reserva.pagada")
  }

  Deployment_Node(sec, "Seguridad y Monitoreo (IE7 / IE8)", "Observabilidad y Llaves") {
    Deployment_Node(kms, "AWS KMS", "Cifrado at-rest de base de datos")
    Deployment_Node(secrets, "AWS Secrets Manager", "Credenciales sin hardcodear")
    Deployment_Node(cw, "Amazon CloudWatch & X-Ray", "Métricas de Auto Scaling y trazas")
  }
}

Rel(viajero, apigw, "POST /api/reservas/confirmar", "HTTPS REST + JWT")
Rel(apigw, alb, "VPC Link", "TLS 1.2+")
Rel(alb, t1, "Balancea :8080", "HTTP")
Rel(alb, t2, "Balancea :8080", "HTTP")

Rel(t1, aurora, "Transacciones JPA", "JDBC TLS (5432)")
Rel(t2, aurora, "Transacciones JPA", "JDBC TLS (5432)")

Rel(t1, redis, "Lock atómico temporal", "RESP (SETNX)")
Rel(t1, msPag, "Solicita cobro síncrono", "REST (Circuit Breaker)")
Rel(t1, msInt, "Re-valida tarifa viva", "REST (Circuit Breaker)")
Rel(t1, sqs, "Publica reserva.pagada", "AWS SDK")

Rel(aurora, kms, "Cifrado en reposo (KMS)", "Keys")
Rel(t1, secrets, "Inyección de credenciales", "IAM Role")
Rel(t1, cw, "Trazas y métricas p95", "CloudWatch / X-Ray")

SHOW_LEGEND()
@enduml
