' =====================================================================
' 1. USUARIOS Y CLIENTES (Nivel 1)
' =====================================================================
rectangle "1. Usuarios y Clientes" as sec_users {
  together {
    Users(viajeros, "Viajeros", "Clientes")
    Users(operadores, "Operadores", "Gestión catálogo")
    Mobileclient(mobile, "App Móvil ViajaMejor", "Flutter")
    Client(web, "Portal Web ViajaMejor", "React SPA")
  }
}

' =====================================================================
' 2. EDGE GLOBAL Y AUTENTICACIÓN (Nivel 2)
' =====================================================================
rectangle "2. Edge Global y Autenticación" as sec_edge {
  together {
    Route53(route53, "Amazon Route 53", "DNS público")
    CloudFront(cdn, "Amazon CloudFront", "CDN catálogo/vouchers")
    WAF(waf, "AWS WAF", "Reglas anti-bot")
    Shield(shield, "AWS Shield", "Anti-DDoS")
    Cognito(cognito, "Amazon Cognito", "Autenticación JWT por rol")
  }
}

' =====================================================================
' 3. API INGRESS DENTRO DE VPC (Nivel 3 - Directamente debajo de Edge)
' =====================================================================
rectangle "3. API Ingress (Borde VPC)" as sec_ingress {
  together {
    APIGateway(apigw, "Amazon API Gateway", "Entrada única REST · JWT Check")
    ElasticLoadBalancing(alb, "ALB Interno", "Balanceo privado :443")
  }
}

' =====================================================================
' 4. VPC VIAJAMEJOR — CÓMPUTO Y EDA
' =====================================================================
rectangle "VPC ViajaMejor (10.0.0.0/16) — Subredes Privadas Multi-AZ" as vpc_main {

  ' Clúster ECS en Matriz 2x4 ordenada con Redis en la esquina correcta
  rectangle "4. Clúster Amazon ECS Fargate (Auto Scaling 2-12 tareas)" as sec_ecs {
    
    together {
      Fargate(msBus, "ms-busqueda", "Spring Boot 3")
      Fargate(msRes, "ms-reservas", "Spring Boot 3")
      Fargate(msPag, "ms-pagos", "Spring Boot 3")
      Fargate(msUsu, "ms-usuarios", "Spring Boot 3")
    }
    
    together {
      ElastiCache(redis, "Amazon ElastiCache (Redis)", "Locks atómicos (SETNX) · Caché tarifas")
      Fargate(msInt, "ms-integraciones", "Spring Boot 3")
      Fargate(msFid, "ms-fidelizacion", "Spring Boot 3")
      Fargate(msNot, "ms-notificaciones", "Spring Boot 3")
      CloudMap(cloudmap, "AWS Cloud Map", "Service Registry")
    }

    msBus -[hidden]right- msRes
    msRes -[hidden]right- msPag
    msPag -[hidden]right- msUsu

    msBus -[hidden]down- redis
    redis -[hidden]right- msInt
    msInt -[hidden]right- msFid
    msFid -[hidden]right- msNot
    msNot -[hidden]right- cloudmap
  }

  ' Bloque EDA a la DERECHA del Clúster
  rectangle "5. Integración y Serverless (EDA)" as sec_eda {
    SimpleQueueService(sqs, "Amazon SQS + DLQ", "reserva.pagada")
    EventBridge(bus, "Amazon EventBridge", "Eventos dominio")
    Lambda(lambdaVoucher, "AWS Lambda", "Generador Vouchers")
    SimpleNotificationService(sns, "Amazon SES / SNS", "Correo / Push")

    sqs -[hidden]down- bus
    bus -[hidden]down- lambdaVoucher
    lambdaVoucher -[hidden]down- sns
  }

  sec_ecs -[hidden]right- sec_eda
}

' =====================================================================
' 5. CAPA DE PERSISTENCIA (Directamente debajo de ECS y EDA)
' =====================================================================
rectangle "6. Capa de Datos y Persistencia (Aislamiento por Dominio)" as sec_datos {
  together {
    Aurora(aurora, "Aurora Serverless v2", "7 BDs aisladas (PostgreSQL Multi-AZ)")
    SimpleStorageService(s3, "Amazon S3", "Vouchers PDF con QR · comprobantes")
  }
}

' =====================================================================
' 6. GOBERNANZA TRANSVERSAL (Abajo a la Derecha)
' =====================================================================
rectangle "Gobernanza Transversal: Seguridad (IE7) y Observabilidad (IE8)" as transversal {
  rectangle "Seguridad y Cumplimiento (IE7) — [Task Roles]" as sec_box {
    IdentityAccessManagementPermissions(iam, "AWS IAM", "Mínimo privilegio")
    KeyManagementService(kms, "AWS KMS", "Cifrado at-rest")
    SecretsManager(secrets, "AWS Secrets Manager", "Credenciales BD")
  }
  rectangle "Observabilidad Unificada (IE8) — [Instrumentación]" as mon_box {
    CloudWatch(cw, "Amazon CloudWatch", "Métricas / alarmas")
    XRay(xray, "AWS X-Ray", "Trazas checkout")
    CloudTrail(trail, "AWS CloudTrail", "Auditoría no repudio")
  }
}

' =====================================================================
' CONEXIONES TOP-DOWN Y LEFT-TO-RIGHT LIMPIAS
' =====================================================================
' Nivel 1 -> Nivel 2
viajeros -down-> mobile
operadores -down-> web
mobile -down-> route53 : HTTPS
web -down-> route53 : HTTPS

' Nivel 2 -> Nivel 3 (Descendente limpio)
route53 -down-> cdn : Resuelve
cdn -down-> apigw : /api (REST)
apigw .[#B71C1C]right.> cognito : 1. Autenticación JWT
apigw .[#B71C1C]up.> waf : 2. Anti-bot / rate limit
cdn .[#B71C1C]up.> shield : 3. Anti-DDoS

' Nivel 3 -> Nivel 4 (Ingress -> ECS)
apigw -down-> alb : VPC Link privado
alb -down-> msRes : /api/reservas
alb -down-> msBus : /api/busqueda
alb -down-> msUsu : /api/usuarios

' Microservicios <-> Redis (Vertical directo sin cruzar cables)
msBus -down-> redis : Consulta tarifas
msRes -down-> redis : Lock cupo SETNX

' Microservicios -> Capa de Datos (Baja directo en vertical)
sec_ecs -down-> aurora : JPA / TLS (1 BD aislada por microservicio)

' Flujo EDA (Sale naturalmente a la DERECHA)
msPag -right-> sqs : reserva.pagada
msRes -right-> bus : reserva.confirmada
sqs -down-> lambdaVoucher : dispara generación
lambdaVoucher -down-> s3 : guarda PDFs con QR
bus -down-> sns : correo / push
bus .left.> msFid : acumula puntos
bus .left.> msNot : prepara email

' Gobernanza Transversal (Suben directo sin cruces)
kms .up.> aurora : Cifrado at-rest BD y S3
kms .up.> s3 : Cifrado at-rest
secrets .up.> aurora : Credenciales
sec_ecs .down.> xray : Trazas flujo crítico
sec_ingress .down.> cw : Métricas de tráfico
trail .right.> s3 : Logs de auditoría

' =====================================================================
' LEYENDA Y MAPEO DE RÚBRICA
' =====================================================================
legend right
  |= Color |= Significado (Mapeo Rúbrica EP01) |
  |<#B71C1C>|  **Seguridad (IE7)** — autenticación JWT, autorización, cifrado KMS, WAF anti-bot, Secrets |
  |<#1565C0>|  **Monitoreo (IE8)** — observabilidad unificada, CloudWatch, trazas X-Ray, CloudTrail |
  |<#37474F>|  Flujo de aplicación y datos (Top-Down y Left-to-Right) |
  | SQS + DLQ | Integridad: no se pierden reservas ante fallas en emisión (RNF-06) |
  | ECS Fargate | Auto scaling independiente por microservicio (RNF-01) |
  | Aurora Serverless | Aislamiento estricto de datos por dominio · Multi-AZ (RNF-02) |
  | ElastiCache | Bloqueos atómicos (SETNX): nunca se sobrevenden cupos (Invariante de negocio) |
endlegend
@enduml
