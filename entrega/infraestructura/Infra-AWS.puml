@startuml Infra-AWS
title ViajaMejor — Infraestructura AWS (Región us-east-1, Multi-AZ)
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam ArrowColor #37474F
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 32
skinparam rectangle {
  BackgroundColor #F8F9FA
  BorderColor #232F3E
  FontColor #232F3E
}

!unquoted procedure Users($alias, $label, $techn)
rectangle "==$label\n<size:10>[$techn]</size>" as $alias #E8EAF6
!endprocedure
!unquoted procedure Mobileclient($alias, $label, $techn)
rectangle "==$label\n<size:10>[$techn]</size>" as $alias #E1F5FE
!endprocedure
!unquoted procedure Client($alias, $label, $techn)
rectangle "==$label\n<size:10>[$techn]</size>" as $alias #E1F5FE
!endprocedure
!unquoted procedure Route53($alias, $label, $techn)
