# Copiar a .env para ejecucion local (NUNCA versionar .env en Git)
# cp .env.example .env

# Base de datos relacional MySQL
MYSQL_ROOT_PASSWORD=cambiar_clave_segura_local
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambiar_clave_segura_local

# Registro de imagenes para Docker Swarm
DOCKER_REGISTRY=ghcr.io/badpek
IMAGE_TAG=latest

# Integracion opcional con AWS SQS (dejar vacio en ejecucion 100% local)
AWS_REGION=us-east-1
SQS_RESERVAS_QUEUE_URL=
SQS_NOTIFICACIONES_QUEUE_URL=
SQS_POLLING_ENABLED=false
